          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login success', function () {",
              "  pm.response.to.have.status(200);",
              "  const json = pm.response.json();",
              "  pm.expect(json.status).to.eql('success');",
              "  pm.expect(json.data.token).to.be.a('string');",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.environment.set('patientToken', json.data.token);",
              "pm.environment.set('userId', String(json.data.user_id));",
              "if (json.data.patient_id) {",
              "  pm.environment.set('patientId', String(json.data.patient_id));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
