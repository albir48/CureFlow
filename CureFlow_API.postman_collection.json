    {
      "name": "Payment - Initiate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token_id\": {{tokenId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/payment/initiate.php",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payment",
            "initiate.php"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Payment initiated', function () {",
              "  pm.expect([200, 422]).to.include(pm.response.code);",
              "  const json = pm.response.json();",
              "  if (pm.response.code === 200) {",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data.payment_id).to.exist;",
              "  } else {",
              "    pm.expect(json.status).to.eql('error');",
              "  }",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.data && json.data.payment_id) {",
              "  pm.environment.set('paymentId', String(json.data.payment_id));",
              "}",
              "if (json.data && json.data.bkashURL) {",
              "  pm.environment.set('bkashURL', json.data.bkashURL);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Payment - Callback (Signed)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const paymentID = pm.environment.get('gatewayPaymentID') || '';",
              "const status = pm.environment.get('callbackStatus') || 'success';",
              "const secret = pm.environment.get('webhookSecret') || '';",
              "const payload = `${paymentID}|${status}`;",
              "const sig = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
              "pm.environment.set('calculatedWebhookSignature', sig);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Webhook-Signature",
            "value": "{{calculatedWebhookSignature}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/payment/callback.php?paymentID={{gatewayPaymentID}}&status={{callbackStatus}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "payment",
            "callback.php"
          ],
          "query": [
            {
              "key": "paymentID",
              "value": "{{gatewayPaymentID}}"
            },
            {
              "key": "status",
              "value": "{{callbackStatus}}"
            }
          ]
        }
      }
    },
