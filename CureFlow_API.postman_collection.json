    {
      "name": "Auth - Generate Local Admin JWT",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "function toBase64UrlUtf8(str) {",
              "  return CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(str))",
              "    .replace(/\\+/g, '-')",
              "    .replace(/\\//g, '_')",
              "    .replace(/=+$/g, '');",
              "}",
              "",
              "function toBase64UrlWordArray(wordArray) {",
              "  return CryptoJS.enc.Base64.stringify(wordArray)",
              "    .replace(/\\+/g, '-')",
              "    .replace(/\\//g, '_')",
              "    .replace(/=+$/g, '');",
              "}",
              "",
              "const secret = pm.environment.get('jwtSecret') || 'dev-secret';",
              "const now = Math.floor(Date.now() / 1000);",
              "const header = { alg: 'HS256', typ: 'JWT' };",
              "const payload = {",
              "  user_id: 1,",
              "  role: 'admin',",
              "  email: 'admin@local.test',",
              "  iat: now,",
              "  exp: now + 3600",
              "};",
              "",
              "const encodedHeader = toBase64UrlUtf8(JSON.stringify(header));",
              "const encodedPayload = toBase64UrlUtf8(JSON.stringify(payload));",
              "const signingInput = `${encodedHeader}.${encodedPayload}`;",
              "const signature = CryptoJS.HmacSHA256(signingInput, secret);",
              "const encodedSignature = toBase64UrlWordArray(signature);",
              "const token = `${signingInput}.${encodedSignature}`;",
              "",
              "pm.environment.set('adminToken', token);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Admin token generated', function () {",
              "  const token = pm.environment.get('adminToken');",
              "  pm.expect(token).to.be.a('string');",
              "  pm.expect(token.split('.').length).to.eql(3);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/doctor/get_doctors.php",
          "host": [
            "{{baseUrl}}"
          ],
